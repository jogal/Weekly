# PRIVATE SYNC IS OFF. These are placeholders, never usable credentials.
# Resource provisioning, OAuth setup/grants, secret configuration and deployment
# require separate owner approval. See docs/private-drive-sync.md.
PRIVATE_SYNC_ENABLED=0
PRIVATE_SYNC_APP_ORIGIN=https://YOUR-APP.example
PRIVATE_SYNC_GOOGLE_CLIENT_ID=YOUR-WEB-CLIENT-ID.apps.googleusercontent.com
PRIVATE_SYNC_GOOGLE_CLIENT_SECRET=REPLACE-IN-SERVER-SECRET-STORE
PRIVATE_SYNC_OWNER_SUB=REPLACE-WITH-VERIFIED-GOOGLE-SUBJECT
PRIVATE_SYNC_OWNER_EMAIL=owner@example.com
PRIVATE_SYNC_ENCRYPTION_KEY=REPLACE-WITH-BASE64-ENCODED-32-BYTE-KEY
UPSTASH_REDIS_REST_URL=https://YOUR-DATABASE.upstash.io
UPSTASH_REDIS_REST_TOKEN=REPLACE-IN-SERVER-SECRET-STORE
PRIVATE_SYNC_REDIS_PREFIX=weekly:private-sync
